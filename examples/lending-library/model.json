    },
    {
      "id": "mark_lost",
      "entity": "book",
      "from": "on_loan",
      "to": "lost",
      "actor_roles": ["member", "librarian"],
      "guard": { "description": "reuses the return guard: the actor is the borrower, or is a librarian", "reads": ["loan.borrower"] },
