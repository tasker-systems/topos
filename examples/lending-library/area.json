{
  "schema_version": "0.2",
  "name": "circulation",
  "target": { "name": "lending-library", "revision": "synthetic-1" },
  "owner": "example-owner",
  "inputs": [
    {
      "role": "structural-topology",
      "ref": "examples/lending-library/topology.json",
      "sha256": "a6640174124923623a4a0f5b83b7c1a0f6ff14e864a7aded638ee5e4da199ed3"
    },
    {
      "role": "clustering",
      "ref": "examples/lending-library/clustering.json",
      "sha256": "8a31b3eaef880342902d73d31abf825a29d48d7a77fd0bfb927b2850303a155c"
    }
  ],
  "derivation": {
    "method": "clustering",
    "algorithm": "layered",
    "clusters": ["layered/c000"],
    "rule": "the cluster that holds the tables a book's circulation status lives in"
  },
  "members": [
    "function:public.can_return(uuid,uuid)",
    "function:public.is_librarian(uuid)",
    "function:public.lend(uuid,uuid,uuid)",
    "function:public.mark_lost(uuid,uuid)",
    "function:public.return_book(uuid,uuid)",
    "policy:public.loans.loans_visible",
    "table:public.books",
    "table:public.loans",
    "trigger:public.books.books_audit",
    "type:public.book_status",
    "view:public.books_on_loan"
  ],
  "hand_edits": [
    {
      "op": "remove",
      "element": "table:public.members",
      "by": "example-owner",
      "reason": "its rows are read here but written only by code outside the schema; it is kept as a boundary rather than analysed"
    }
  ],
  "exclusions": [],
  "boundary": [
    {
      "edge": "executes:trigger:public.books.books_audit->function:public.touch_book()",
      "inside": "trigger:public.books.books_audit",
      "outside": "function:public.touch_book()",
      "class": "state-carrying",
      "basis": "a trigger fires on a write and passes the row to its function"
    },
    {
      "edge": "foreign_key:table:public.loans->table:public.members",
      "inside": "table:public.loans",
      "outside": "table:public.members",
      "class": "reference-only",
      "basis": "a foreign key names the other side without reading its state"
    },
    {
      "edge": "reads:function:public.is_librarian(uuid)->table:public.members",
      "inside": "function:public.is_librarian(uuid)",
      "outside": "table:public.members",
      "class": "state-carrying",
      "basis": "the table has no extracted writer, so it is written outside the schema"
    }
  ]
}
